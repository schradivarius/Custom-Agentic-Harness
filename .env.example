# ─── Microsoft Foundry project ────────────────────────────────────────────────
# Foundry portal → your project → Overview → "Azure AI Foundry project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# The agent you are hosting. Foundry agents are addressed by NAME (versions are
# created under that name), not by a thread-style id.
FOUNDRY_AGENT_NAME=my-agent

# Model deployment name, as shown in "Models + endpoints" → Name column.
# Only needed when FOUNDRY_SYNC_TOOLS=true (to create/update an agent version)
# or when you want to talk to a bare model with no agent.
FOUNDRY_MODEL_NAME=gpt-4.1

# How to attach the agent reference to each Responses call.
#   client = project.getOpenAIClient({ azureConfig: { agentName } })   (default)
#   body   = per-request body override { agent_reference: { ... } }
# The Azure SDK samples disagree on the body key; "client" sidesteps it.
FOUNDRY_AGENT_REF_MODE=client

# Push this harness's local function-tool schemas up to the agent as a new
# agent version on boot. Leave false if you manage tools in the portal —
# but note the model can only call local tools it has been told about.
FOUNDRY_SYNC_TOOLS=false

# System prompt used when you address a turn at a bare MODEL DEPLOYMENT rather
# than a hosted agent. An agent carries its own instructions, so this is ignored
# in that case. Leave unset for a sensible default.
#MODEL_INSTRUCTIONS=You are a desktop assistant with access to the user's workspace.

# ─── Harness ──────────────────────────────────────────────────────────────────
PORT=4300

# Root directory that filesystem tools are confined to. Nothing outside it is
# readable or writable, symlinks included.
WORKSPACE_ROOT=./workspace

# Risk tiers auto-approved without prompting. Comma-separated: safe,caution,dangerous
# Anything not listed raises an approval prompt in the UI.
AUTO_APPROVE=safe

# Enable the shell tool (off by default). Commands are still allowlisted below.
ENABLE_SHELL=false
SHELL_ALLOWLIST=git,ls,cat,rg,node,npm,python3

# Seconds to wait for a human approval decision before failing the tool call.
APPROVAL_TIMEOUT_SECONDS=300
